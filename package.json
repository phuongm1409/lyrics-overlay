{
  "name": "lyrics-overlay",
  "version": "1.2.2",
  "description": "Spotify lyrics overlay",
  "author": "you",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.lyricsoverlay",
    "productName": "LyricsOverlay",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "subtitles.js",
      "google-drive.js",
      "overlay.js",
      "index.html",
      "editor.html",
      "settings.html",
      "*.svg",
      "assets/icon.png",
      "assets/fonts/*",
      "package.json"
    ]
  }
}

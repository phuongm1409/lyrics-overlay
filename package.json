{
  "name": "lyrics-overlay",
  "version": "1.0.0",
  "description": "Spotify lyrics overlay",
  "author": "you",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.lyricsoverlay",
    "productName": "LyricsOverlay",
    "win": { "target": ["portable"], "icon": "app-icon.png" },
    "files": ["main.js", "preload.js", "index.html", "editor.html", "icon.png", "package.json"]
  }
}
